# 复制本文件为 llm_backend/.env 后按实际情况填写。
# 所有密钥均为占位符，切勿把真实 .env 提交到仓库。

# ---------- 在线模型 ----------
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 视觉模型（图片理解），可用任意 OpenAI 兼容端点
VISION_API_KEY=sk-your-vision-key
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4o

# ---------- Ollama 本地模型 ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_REASON_MODEL=deepseek-r1:7b
OLLAMA_AGENT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=bge-m3

# 服务选择：deepseek 或 ollama
CHAT_SERVICE=deepseek
REASON_SERVICE=deepseek
AGENT_SERVICE=deepseek

# ---------- 联网搜索 ----------
SERPAPI_KEY=your-serpapi-key
SEARCH_RESULT_COUNT=5

# ---------- 业务数据库 ----------
# sqlite（零安装，默认）或 mysql
DB_TYPE=sqlite
SQLITE_PATH=data/kefu_agent.db
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=kefu_agent

# ---------- Neo4j 知识图谱 ----------
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# ---------- Redis 语义缓存 ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_EXPIRE=3600
REDIS_CACHE_THRESHOLD=0.90
EMBEDDING_TYPE=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_THRESHOLD=0.90

# ---------- 身份认证 ----------
# 部署前务必替换为随机长字符串
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------- Microsoft GraphRAG ----------
# 相对路径基于项目根目录；配置模板在 llm_backend/graphrag_project/data/
GRAPHRAG_PROJECT_DIR=graphrag_project
GRAPHRAG_DATA_DIR=data
GRAPHRAG_EMBEDDING_MODEL=text-embedding-3-small
GRAPHRAG_QUERY_TYPE=local
GRAPHRAG_RESPONSE_TYPE=text
GRAPHRAG_COMMUNITY_LEVEL=3
GRAPHRAG_DYNAMIC_COMMUNITY=false

# ---------- 服务启动（可选） ----------
HOST=0.0.0.0
PORT=8000
RELOAD=true
LOG_LEVEL=error
